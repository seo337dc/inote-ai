GROQ_API_KEY=gsk_xxxx
ALLOWED_ORIGINS=http://localhost:3011
DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require
INTERNAL_SECRET=change-me
INOTE_SERVER_URL=http://localhost:3200/api/v1
# 글 임베딩(KURE) — 임베딩 서비스(inote-embedder). 없으면 임베딩 API는 503, inote-server는 이를 무시하고 글 저장은 정상 동작한다
EMBEDDER_URL=
# 임베딩 서비스가 기대하는 비밀키 (inote-server와 공유하는 INTERNAL_SECRET과는 다른 값)
EMBEDDER_SECRET=
EMBEDDER_MODEL=nlpai-lab/KURE-v1
# 글 목록 채팅(글 찾기)의 검색 기준 점수(0~1). 없으면 0.5 — 평가 세트(A7)로 확정할 임시값
POSTS_CHAT_MIN_SCORE=0.5
POSTS_CHAT_SCORE_MARGIN=0.09
