GROQ_API_KEY=gsk_xxxx
ALLOWED_ORIGINS=http://localhost:3011
DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require
INTERNAL_SECRET=change-me
INOTE_SERVER_URL=http://localhost:3200/api/v1
# 글 임베딩(KURE) — 임베딩 서비스(inote-embedder). 없거나 닿지 못하면 글 저장(PUT)은 작업 대기열(embedding_job)에 남기고 202(queued)로 답한다(글 저장은 정상 동작). 유사 글 조회는 503
EMBEDDER_URL=
# 임베딩 서비스가 기대하는 비밀키 (inote-server와 공유하는 INTERNAL_SECRET과는 다른 값)
EMBEDDER_SECRET=
EMBEDDER_MODEL=nlpai-lab/KURE-v1
# (선택) 임베딩 서비스 요청 하나의 제한 시간(초, 0 초과 300 이하, 기본 40)과 실패 시 재시도 횟수(0~5, 기본 0 — 기다리는 요청은 오래 붙들리면 안 된다)
# EMBEDDER_TIMEOUT=40
# EMBEDDER_RETRIES=0
# (선택, 대기열 워커용 — scripts/embedding_worker.py는 .env를 읽지 않으니 실행할 때 환경변수로 준다) 작업 하나의 최대 시도 횟수(1~20, 기본 5)와 "처리 중" 정체 판단 시간(초, 기본 600)
# EMBEDDING_JOB_MAX_ATTEMPTS=5
# EMBEDDING_JOB_STALE_SECONDS=600
# 글 목록 채팅(글 찾기)의 검색 기준 점수(0~1). 없으면 0.5 — 평가 세트(A7)로 확정할 임시값
POSTS_CHAT_MIN_SCORE=0.5
POSTS_CHAT_SCORE_MARGIN=0.09
